@model RestauranteApp.Models.ItemMenu
@using RestauranteApp.Models

@{
    ViewData["Title"] = "Create";
    var ingredientes = ViewData["Ingredientes"] as List<Ingrediente> ?? new List<Ingrediente>();
}

<h1>Create</h1>

<h4>ItemMenu</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="NombreItem" class="control-label"></label>
                <input asp-for="NombreItem" class="form-control" />
                <span asp-validation-for="NombreItem" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Descripcion" class="control-label"></label>
                <input asp-for="Descripcion" class="form-control" />
                <span asp-validation-for="Descripcion" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Precio" class="control-label"></label>
                <input asp-for="Precio" class="form-control" />
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CategoriaId" class="control-label"></label>
                <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select>
            </div>

            <div class="form-group">
                <label asp-for="Estado" class="control-label"></label>
                <select asp-for="Estado" class="form-control" asp-items="@(new SelectList(new List<string> { "Activo", "Inactivo" }, "Activo"))">
                </select>
                <span asp-validation-for="Estado" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label for="imagenFile" class="control-label">Imagen</label>
                <input type="file" id="imagenFile" name="imagenFile" class="form-control" accept="image/*" title="Seleccione una imagen para el item del menú" />
                <span class="text-muted">Seleccione una imagen para el item del menú</span>
            </div>

            <div class="form-group p-3 border rounded bg-light">
                <h5>Ingredientes del platillo</h5>
                <div class="row g-2 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Ingrediente</label>
                        <select id="ingredienteSelect" class="form-select" aria-label="Seleccione un ingrediente">
                            <option value="">Seleccione un ingrediente</option>
                            @foreach (var ingrediente in ingredientes)
                            {
                                <option value="@ingrediente.IngredienteId"
                                        data-unidad="@ingrediente.UnidadMedida"
                                        data-nombre="@ingrediente.NombreIngrediente">
                                    @ingrediente.NombreIngrediente
                                </option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cantidad</label>
                        <input type="number" id="cantidadIngrediente" class="form-control" min="0" step="0.001" placeholder="Ej. 0.250" aria-label="Cantidad del ingrediente" />
                    </div>
                    <div class="col-md-2">
                        <button type="button" id="agregarIngrediente" class="btn btn-secondary w-100">Agregar</button>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-sm table-bordered" id="tablaIngredientes">
                        <thead>
                            <tr>
                                <th>Ingrediente</th>
                                <th>Cantidad</th>
                                <th>Unidad</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody></tbody>
                    </table>
                </div>
                <small class="text-muted">Agregue todos los ingredientes que se ocupan para la elaboración del platillo y la cantidad necesaria de cada uno.</small>
            </div>

            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        let indiceIngrediente = 0;

        function agregarIngrediente() {
            const select = document.getElementById('ingredienteSelect');
            const cantidad = document.getElementById('cantidadIngrediente');
            const opcion = select.options[select.selectedIndex];
            const ingredienteId = select.value;
            const nombreIngrediente = opcion.getAttribute('data-nombre');
            const unidad = opcion.getAttribute('data-unidad');

            if (!ingredienteId) {
                alert('Seleccione un ingrediente.');
                return;
            }

            if (!cantidad.value || Number(cantidad.value) <= 0) {
                alert('Ingrese una cantidad mayor a 0.');
                return;
            }

            const tbody = document.querySelector('#tablaIngredientes tbody');
            const fila = document.createElement('tr');
            fila.dataset.indice = indiceIngrediente;

            fila.innerHTML = `
                <td>
                    ${nombreIngrediente}
                    <input type="hidden" name="ItemMenuIngredientes[${indiceIngrediente}].IngredienteId" value="${ingredienteId}" />
                    <input type="hidden" name="ItemMenuIngredientes[${indiceIngrediente}].ItemMenuId" value="0" />
                </td>
                <td>
                    <input type="number" name="ItemMenuIngredientes[${indiceIngrediente}].Cantidad" value="${cantidad.value}" min="0" step="0.001" class="form-control form-control-sm" />
                </td>
                <td>${unidad}</td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm" onclick="eliminarIngrediente(this)">Eliminar</button>
                </td>
            `;

            tbody.appendChild(fila);

            select.value = '';
            cantidad.value = '';
            indiceIngrediente++;
        }

        function eliminarIngrediente(boton) {
            boton.closest('tr').remove();
        }

        document.getElementById('agregarIngrediente').addEventListener('click', agregarIngrediente);
    </script>
}
