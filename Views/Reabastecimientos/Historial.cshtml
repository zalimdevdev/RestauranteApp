@model RestauranteApp.ViewModels.DetalleMovimientoVM

@{
    ViewData["Title"] = "Historial de Movimientos - " + Model.NombreIngrediente;
}

<h1>Historial de Movimientos</h1>
<h3>@Model.NombreIngrediente</h3>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <div class="alert alert-info">
                <strong>Stock Actual:</strong> @Model.StockActual
            </div>
            
            <a asp-action="Index" class="btn btn-secondary mb-3">Volver a Ingredientes</a>
            <a asp-action="Create" class="btn btn-primary mb-3">Nuevo Reabastecimiento</a>
        </div>
    </div>

    <div class="row">
        <div class="col-md-12">
            <table class="table table-striped table-hover">
                <thead class="thead-dark">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Movimientos.First().Tipo)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Movimientos.First().Cantidad)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Movimientos.First().Fecha)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Movimientos.First().Observacion)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Movimientos.First().FacturaId)
                        </th>
                    </tr>
                </thead>
                <tbody>
@foreach (var item in Model.Movimientos) {
                    <tr>
                        <td>
                            @if (item.Tipo == "Entrada")
                            {
                                <span class="badge badge-success">@item.Tipo</span>
                            }
                            else
                            {
                                <span class="badge badge-danger">@item.Tipo</span>
                            }
                        </td>
                        <td>@item.Cantidad</td>
                        <td>@item.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                        <td>@item.Observacion</td>
                        <td>
                            @if (item.FacturaId.HasValue)
                            {
                                <a asp-action="Details" asp-controller="Facturas" asp-route-id="@item.FacturaId" class="btn btn-sm btn-info">
                                    Factura #@item.FacturaId
                                </a>
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    </tr>
}
                </tbody>
            </table>

            @if (!Model.Movimientos.Any())
            {
                <div class="alert alert-warning">
                    No hay movimientos registrados para este ingrediente.
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
