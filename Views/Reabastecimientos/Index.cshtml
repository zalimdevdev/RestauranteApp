@model IEnumerable<RestauranteApp.Models.Ingrediente>

@{
    ViewData["Title"] = "Gestión de Ingredientes";
}

<h1>Gestión de Ingredientes</h1>

<div class="container mt-4">
    <div class="row">
        <div class="col-md-12">
            <a asp-action="Create" class="btn btn-primary mb-3">Reabastecer Ingrediente</a>
        </div>
    </div>

    <table class="table table-striped table-hover">
        <thead class="thead-dark">
            <tr>
                <th>
                    @Html.DisplayNameFor(model => model.NombreIngrediente)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.CantidadStock)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.UnidadMedida)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Costo)
                </th>
                <th>
                    @Html.DisplayNameFor(model => model.Categoria)
                </th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
@foreach (var item in Model) {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.NombreIngrediente)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CantidadStock)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.UnidadMedida)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Costo)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Categoria)
                </td>
                <td>
                    <a asp-action="Historial" asp-route-id="@item.IngredienteId" class="btn btn-sm btn-info" title="Ver historial">
                        <i class="fas fa-history"></i> Historial
                    </a>
                    <a asp-action="Create" class="btn btn-sm btn-success" title="Reabastecer">
                        <i class="fas fa-plus"></i> Reabastecer
                    </a>
                </td>
            </tr>
}
        </tbody>
    </table>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}